{
  "name": "@learning-tracker/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "predev": "mkdir -p .data",
    "dev": "DATA_DIR=${DATA_DIR:-.data} PATHS_DIR=${PATHS_DIR:-../paths} tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@learning-tracker/core": "*",
    "fastify": "^5.6.0",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.20.0"
  }
}
